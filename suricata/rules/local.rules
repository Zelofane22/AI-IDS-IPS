# Local DEMO rules for the AI-IDS-IPS prototype.
# These rules are intentionally simple and are NOT a production ruleset.

alert icmp any any -> any any (msg:"DEMO ICMP echo request"; itype:8; sid:1000001; rev:1;)

alert http any any -> any any (msg:"DEMO suspicious HTTP URI /admin"; flow:to_server,established; http.uri; content:"/admin"; nocase; sid:1000002; rev:1;)

alert tcp any any -> any 22 (msg:"DEMO SSH connection attempt"; flow:to_server; sid:1000003; rev:1;)

alert tcp any any -> any 23 (msg:"DEMO Telnet connection attempt"; flow:to_server; sid:1000004; rev:1;)

alert tcp any any -> any 3389 (msg:"DEMO RDP connection attempt"; flow:to_server; sid:1000005; rev:1;)

# Generic textbook signatures for scans and floods (not tuned on CIC-IDS2017 labels).
# Needed so that Suricata can see the real attacks of the CIC Friday extract.
alert tcp any any -> $HOME_NET any (msg:"LOCAL TCP SYN scan (>=30 SYN in 5s from one source)"; flow:stateless; flags:S,12; threshold:type threshold, track by_src, count 30, seconds 5; classtype:attempted-recon; sid:1000010; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"LOCAL TCP NULL scan"; flow:stateless; flags:0; classtype:attempted-recon; sid:1000011; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"LOCAL TCP XMAS scan"; flow:stateless; flags:FPU,12; classtype:attempted-recon; sid:1000012; rev:1;)

alert http any any -> $HOME_NET any (msg:"LOCAL HTTP GET flood (>=50 requests in 5s from one source)"; flow:to_server,established; http.method; content:"GET"; threshold:type threshold, track by_src, count 50, seconds 5; classtype:attempted-dos; sid:1000013; rev:1;)
